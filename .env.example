# xAI Grok (compulsory - this application's only LLM)
XAI_API_KEY=
XAI_MODEL=grok-4-fast-reasoning

# Hindsight (compulsory - this application's persistent agent memory layer)
# Local Docker: HINDSIGHT_BASE_URL=http://localhost:8888 and HINDSIGHT_API_KEY can be left blank.
# Hindsight Cloud: HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io and set HINDSIGHT_API_KEY.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incident-response-agent

# Local SQLite database file (optional override)
DATABASE_URL=file:./.data/app.db
